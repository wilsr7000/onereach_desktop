# Dependencies
node_modules/

# Build outputs
dist/
dist-lite/
out/
*.app
*.exe
*.dmg
*.AppImage
*.snap

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE Files
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary files
_temp/
temp/
tmp/
*.tmp
*.temp

# Archive/Backup files
_archive/
*.backup
*.bak
*-backup.*
*-broken.*

# Test outputs
test-report-*.json
coverage/
.nyc_output/
test-results/
playwright-report/
*.spec.js.snap

# Test audit state (local runtime state, not committed)
test/audit/state/

# Generated media test fixtures (regenerate with: npm run test:generate-fixtures)
# Only the generator script is tracked; binary files are generated locally.
test/fixtures/media/sample.png
test/fixtures/media/sample.jpg
test/fixtures/media/sample.gif
test/fixtures/media/sample.bmp
test/fixtures/media/sample.svg
test/fixtures/media/sample.webp
test/fixtures/media/sample.wav
test/fixtures/media/sample.mp3
test/fixtures/media/sample.mp4
test/fixtures/media/sample.pdf
test/fixtures/media/sample.txt

# Scripts directory (optional - remove if you want to track scripts)
_scripts/

# Environment files
.env
.env.local
.env.*.local

# Storage status files
.storage-*-status

# Base64 encoded files (redundant)
*-base64*.txt

# Cache
.cache/
*.cache

# Package lock files (uncomment if you prefer not to track)
# package-lock.json
# yarn.lock

# Electron-specific
# electron-builder.yml was ignored here for years (early boilerplate).
# UN-ignored 2026-08-17: it now carries mac.preAutoEntitlements=false —
# the AMFI-brick prevention — and an ignored safety config is exactly
# the gitignored-profile failure mode that bricked Lite 0.0.63-0.0.70.
# It contains no secrets (the export guard scans for real key material).
app/dist/

# Claude Code binaries (downloaded at build time)
resources/claude-code/

# Debug files
debug-*.html
debug-*.js

# Test files (uncomment if you don't want to track test files)
# test-*.html
# test-*.js
# *-test.js 

# Certification and notarization credentials
.env.notarization
.env.apple
.env.signing
**/notarization-credentials.json
certify-*.log
# ── Code-signing material (open-source: inject via CI, never commit) ──
# Private keys sign as "OneReach, Inc." — must never be public. The
# provisioning profile is public-cert-only but is CI-injected, not tracked,
# so forks supply their own. The export guard blocks any of these if staged.
*.p12
*.pfx
*.cer
*.keystore
*.mobileprovision
*.provisionprofile

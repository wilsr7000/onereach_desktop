<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Electron V8 engine -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    
    <!-- AppleScript/Automation support -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    
    <!-- Network access for API calls, updates, and web content -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- Microphone access for speech recognition -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    
    <!-- Camera access (if needed for future features) -->
    <key>com.apple.security.device.camera</key>
    <true/>
    
    <!-- File access for user documents -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    <!-- ADR-066: Touch ID WebAuthn (Secure Enclave platform authenticator).
         These three RESTRICTED entitlements are valid ONLY because the
         Developer ID provisioning profile embedded via
         mac.provisioningProfile allowlists them (keychain wildcard
         6KTEPA3LSD.*). Without that profile macOS SIGKILLs the app at
         launch — the paired guard test enforces profile + entitlements
         move together. Helpers sign with entitlements.mac.inherit.plist
         (no restricted keys, no profile needed). -->
    <!-- application-identifier/team-identifier are deliberately NOT
         requested: with them present the app SIGTRAPs at startup
         (live-bisected 2026-08-14; Chromium objects on macOS). AMFI
         only requires requested entitlements ⊆ profile, and the
         keychain group alone satisfies configureWebAuthn. -->
    <key>keychain-access-groups</key>
    <array>
        <string>6KTEPA3LSD.com.onereach.lite.webauthn</string>
    </array>
</dict>
</plist>

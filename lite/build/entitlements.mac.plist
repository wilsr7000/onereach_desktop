<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Electron V8 engine -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    
    <!-- AppleScript/Automation support -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    
    <!-- Network access for API calls, updates, and web content -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- Microphone access for speech recognition -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    
    <!-- Camera access (if needed for future features) -->
    <key>com.apple.security.device.camera</key>
    <true/>
    
    <!-- File access for user documents -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    <!-- ADR-066: Touch ID WebAuthn — the keychain-access-groups
         entitlement is DELIBERATELY ABSENT. Under Developer ID signing
         it is a RESTRICTED entitlement: without an embedded Developer ID
         provisioning profile, AMFI SIGKILLs the app at launch
         (live-confirmed 2026-08-14, exit 137 — a release would have
         killed every install). To enable Touch ID passkeys:
           1. Apple portal: create a Developer ID provisioning profile
              for com.onereach.lite with Keychain Sharing
              (group 6KTEPA3LSD.com.onereach.lite.webauthn).
           2. electron-builder: mac.provisioningProfile → that file.
           3. Restore here: keychain-access-groups +
              com.apple.application-identifier (6KTEPA3LSD.com.onereach.lite)
              + com.apple.developer.team-identifier (6KTEPA3LSD).
         Until then app.configureWebAuthn is harmlessly inert. -->
</dict>
</plist> 